}
document.getElementById("power").addEventListener("click", () => { void enableSound(); });
const DRUM_START_LEVEL = 0.2;
function syncDrumAudio(landing) {
  if (drumAudio.hidden === landing) drumAudio.hidden = !landing;
  if (!landing) return;
  const ready = audio?.state === "running" && masterLevel > 0;
  const text = soundStarting ? "Starting audio…" : ready ? "Browser volume " + Math.round(masterLevel * 100) + "%"
    : masterLevel === 0 ? "Enable pad audio · set volume to 20%" : "Enable pad audio";
  if (drumAudio.textContent !== text) drumAudio.textContent = text;
  const disabled = !!soundStarting || ready;
  if (drumAudio.disabled !== disabled) drumAudio.disabled = disabled;
}
drumAudio.addEventListener("click", () => {
  if (!x || drumPadDeck() < 0 || pendingTurns[0] || soundStarting) return;
  if (masterLevel === 0) setMasterLevel(DRUM_START_LEVEL);
  void enableSound();
});
function syncDrumRecovery(landing, stepBank) {
  drumRecoveryState = x.emu_ui_drum_recovery_state?.() ?? 0;
  const reason = drumRecoveryState & 255;
  const drumSteps = !!stepBank && !(stepBank >>> 16);
  const volume = drumSteps && !reason && masterLevel === 0;
  const show = !!drumRecoveryState && (landing || drumSteps) && (!!reason || volume);
  drumRecovery.hidden = !show;
  if (!show) return;
  const name = (drumRecoveryState >>> 8) === 2 ? "Drum B" : "Drum A";
  let status, action;
  if (volume) {
    status = "Browser volume is at zero.";
    action = "Enable sound at 20%";
  } else if (reason === 1) {
    status = name + " is off.";
    action = "Enable " + name;
  } else if (reason === 2) {
    status = name + " is muted.";
    action = "Unmute " + name;
  } else if (reason === 3) {
    status = name + " level is at zero.";
    action = "Set " + name + " to 25%";
  } else {
    const solo = ["Drum A", "Drum B", "Dillo"][reason - 4];
    status = solo + " is soloed. " + name + " is excluded.";
    action = "Clear " + solo + " solo";
  }
  if (drumRecoveryStatus.textContent !== status) drumRecoveryStatus.textContent = status;
  if (drumRecover.textContent !== action) drumRecover.textContent = action;
  drumRecover.disabled = volume && !!soundStarting;
}
drumRecover.addEventListener("click", () => {
