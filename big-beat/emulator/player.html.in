    requestedDrumDeck = index;
    // A desktop pointer user can keep playing the computer keys immediately.
    if (event.detail && !phoneLayout.matches) keyViews[0][1].focus({preventScroll: true});
  });
}

conductorCancel.addEventListener("pointerdown", () => { pointerCancelTicket = cancelTicket; });
