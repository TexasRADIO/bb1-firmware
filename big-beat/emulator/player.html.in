 if(kind === "saved") return changed ? "RAM edits since save" : "Saved project · no new edits";
 if(kind === "imported") return changed ? "RAM edits since import" : "Imported project · no new edits";
 return changed ? "RAM project · save to keep" : "New RAM project · no edits";
