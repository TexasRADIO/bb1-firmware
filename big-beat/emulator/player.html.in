 clearCapturedTabRecovery();
 // The project owner has validated the header and the catalogue migration.
 openedPublic211=kind==='project'&&new DataView(wire.buffer,wire.byteOffset,wire.byteLength).getUint32(20,true)===0xa594ccd5;
 const keepOriginal=openedPublic211?' Save a separate copy for Conductor and keep the original for 2.1.1.':'';
 projectMessage(`Opened ${kind} “${file.name}”. Arrangement and sounds restored. Playback stopped and Undo starts fresh.${keepOriginal}`);
}));

const projectState=document.getElementById('project-state');
setInterval(()=>{
 if(!x)return;
 const unavailable = projectFileBusy ? '' : projectUnavailable();
 if(!projectFilesReady && !unavailable){
  projectFilesReady=true;
  projectDownload.disabled=projectOpen.disabled=false;
 }
 const message = unavailable || projectStatus();
 if (projectState.textContent !== message) projectState.textContent = message;
},120);


/* BEGIN TAB RECOVERY */
const recoveryPanel = document.getElementById("project-recovery");
const recoverButton = document.getElementById("project-recover");
const discardRecovery = document.getElementById("project-recovery-discard");
const recoveryKey = "bb1-tab-recovery-v1:" + location.pathname;
let tabRecovery, recoveryAvailable = true, recoveryStamp = "";
let recoveryIdleUntil = 0, recoverySnapshot = null;
try { tabRecovery = sessionStorage.getItem(recoveryKey); }
catch { recoveryAvailable = false; }
recoveryPanel.hidden = tabRecovery == null;

function projectNeedsFile() {
  return !!projectCheckpoint && (projectCheckpoint.kind === "recovered" || projectChanged());
}
window.addEventListener("beforeunload", event => {
  if (!projectNeedsFile()) return;
  event.preventDefault();
  event.returnValue = true;
});

function clearTabRecovery() {
  sessionStorage.removeItem(recoveryKey);
  tabRecovery = null;
  recoveryStamp = "";
  recoveryPanel.hidden = true;
}

function clearCapturedTabRecovery() {
  // A copy offered at startup may belong to a different unsaved project.
  if (!recoveryStamp) return;
  try { clearTabRecovery(); }
  catch { recoveryAvailable = false; }
}

for (const event of ["pointerdown", "keydown", "wheel", "click"])
  document.addEventListener(event, () => {
    recoveryIdleUntil = performance.now() + 2000;
    // Release the automatic audio hold before this gesture reaches the panel.
    recoverySnapshot?.abort();
  }, {capture:true, passive:true});

async function keepTabRecovery() {
  if (!projectFilesReady || projectFileBusy || recoverySnapshot || !recoveryAvailable || tabRecovery != null) return;
  if (!projectNeedsFile()) {
    clearCapturedTabRecovery();
    return;
  }
  if (document.hidden || !document.hasFocus() || performance.now() < recoveryIdleUntil || projectUnavailable() ||
      pendingTurns.some(Boolean) || keyHolds.some(holds => holds.size) || buttonHolds.some(holds => holds.size)) return;
  const stamp = projectStamp().join("/");
  if (stamp === recoveryStamp) return;
  recoverySnapshot = new AbortController();
  let snapshot;
  try {
    snapshot = await projectHeld(() => {
      if (document.hidden || performance.now() < recoveryIdleUntil) return null;
      const n = x.emu_project_export();
      if (!n) return null;
      const bytes = new Uint8Array(x.memory.buffer, x.emu_project_ptr(), n);
      return {text:btoa(String.fromCharCode(...bytes)), stamp:projectStamp().join("/")};
    }, recoverySnapshot.signal);
  } catch {
    // A later idle window may be able to take the owner safely.
    return;
  } finally {
    recoverySnapshot = null;
  }
  if (!snapshot) return;
  try {
    sessionStorage.setItem(recoveryKey, snapshot.text);
    recoveryStamp = snapshot.stamp;
  } catch { recoveryAvailable = false; }
}
setInterval(keepTabRecovery, 1000);

recoverButton.addEventListener("click", () => projectJob(async () => {
  if (tabRecovery == null) return;
  const unavailable = projectUnavailable();
  if (unavailable) return projectMessage(unavailable);
  const limit = x.emu_project_capacity();
  let wire;
  try {
    if (tabRecovery.length > Math.ceil(limit / 3) * 4) throw Error();
    wire = Uint8Array.from(atob(tabRecovery), c => c.charCodeAt(0));
    if (wire.length < 64 || wire.length > limit) throw Error();
  } catch { return projectMessage("This tab recovery copy is unreadable. Current project unchanged."); }
  if (projectNeedsFile() && !window.confirm("Recover the tab copy and replace the current RAM project?")) return;
  await projectHeld(() => {
    new Uint8Array(x.memory.buffer, x.emu_project_ptr(), wire.length).set(wire);
    const result = x.emu_project_import(wire.length);
    if (result) throw Error(projectErrors[result] || `Recovery refused (${result}).`);
  });
  rememberProject("recovered");
  openedPublic211 = false;
  // Keep this copy through another reload until a newer one replaces it.
  tabRecovery = null;
  recoveryStamp = projectStamp().join("/");
  recoveryPanel.hidden = true;
  projectMessage("Tab edits recovered. Save a project file to keep them.");
}));

discardRecovery.addEventListener("click", () => {
  if (projectFileBusy || tabRecovery == null || !window.confirm("Discard this tab's recovery copy?")) return;
  try { clearTabRecovery(); }
  catch { projectMessage("The browser could not remove this tab's recovery copy."); }
});
/* END TAB RECOVERY */

</script>
<p class="notes"><a href="/fm1/emulator/">Earlier BB-1 1.5 player and its review form</a></p>
