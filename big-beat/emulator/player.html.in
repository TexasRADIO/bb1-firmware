stepVoiceSelect.addEventListener("change", () => {
  if (stepVoiceContext && !drumDeckChangeBlocked())
    x.emu_ui_step_voice_choose(stepVoiceContext, stepVoiceSelect.selectedIndex);
  syncStepVoicePicker(x, x.emu_ui_step_bank?.() ?? 0);
});

stepVoiceAudition.addEventListener("click", async () => {
  if (!stepVoiceContext || stepVoiceAudition.disabled || drumDeckChangeBlocked()) return;
  const context = stepVoiceContext, voice = stepVoiceSelect.selectedIndex;
  await enableSound();
  if (audio?.state === "running" && masterLevel > 0 && !drumDeckChangeBlocked())
    x.emu_ui_step_voice_audition(context, voice);
});

function buildDrumMix() {
  const groupNames = ["Kick", "Snare / clap", "Hats", "Percussion"];
  for (const [group, name] of groupNames.entries()) {
    const strip = document.createElement("article");
    const label = document.createElement("strong");
    label.textContent = name;
    const level = document.createElement("span");
    const meter = document.createElement("meter");
    meter.max = 127;
    meter.setAttribute("aria-label", name + " gain setting");
    const controls = document.createElement("div");
    controls.className = "mix-buttons";
    const buttons = [[-8, "−", " level down"], [8, "+", " level up"], [0, "Mute", " mute"]]
      .map(([delta, text, description]) => {
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = text;
        button.setAttribute("aria-label", name + description);
        button.addEventListener("click", () => {
          if (renderedDrumMixDeck < 0 || requestedDrumDeck >= 0 || drumDeckChangeBlocked()) return;
          x.emu_ui_drum_mix_press(renderedDrumMixDeck, group, delta);
        });
        controls.append(button);
        return button;
      });
    buttons[2].className = "mix-mute";
    strip.append(label, level, meter, controls);
    drumMix.lastElementChild.append(strip);
    drumMixStrips.push({level, meter, buttons});
  }
}
buildDrumMix();

function syncDrumMix(landing) {
  renderedDrumMixDeck = landing && x.emu_ui_drum_mix ? drumPadDeck() : -1;
  drumMix.hidden = renderedDrumMixDeck < 0;
  if (drumMix.hidden) return;
  const title = "Drum " + (renderedDrumMixDeck ? "B" : "A") + " group mix";
  if (drumMixHeading.textContent !== title) drumMixHeading.textContent = title;
  let anySolo = false;
  for (const [group, strip] of drumMixStrips.entries()) {
    const state = x.emu_ui_drum_mix(renderedDrumMixDeck, group);
    const level = state & 127;
    const muted = !!(state & 128), solo = !!(state & 256), excluded = !!(state & 512);
    anySolo ||= solo;
    const status = solo ? "Solo" : excluded ? "Other group soloed" : muted ? "Muted" : "";
    const text = state ? Math.round(level * 100 / 127) + "%" + (status ? " · " + status : "") : "Waiting…";
    if (strip.level.textContent !== text) strip.level.textContent = text;
    if (strip.meter.value !== level) strip.meter.value = level;
    const [down, up, mute] = strip.buttons;
    down.disabled = !state || !level;
    up.disabled = !state || level === 127;
    mute.disabled = !state || solo || excluded;
    if (mute.getAttribute("aria-pressed") !== String(muted)) mute.setAttribute("aria-pressed", String(muted));
    const label = muted ? "Unmute" : "Mute";
    if (mute.textContent !== label) mute.textContent = label;
  }
  drumMixHelp.hidden = !anySolo;
}

function syncStageBand(firmware, sectionSet) {
  const show = !!sectionSet && !!firmware.emu_conductor_stage_song;
  stageBand.hidden = !show;
  if (!show) {
    stageBandResult.textContent = "";
    return false;
  }
  const state = firmware.emu_conductor_stage_song_state();
  const label = state === 2 ? "Stop to stage band" :
    state === 3 ? "Band not ready to stage" : "Stage band for song";
  if (stageBand.textContent !== label) stageBand.textContent = label;
  stageBand.disabled = state !== 1 || projectFileBusy || pendingTurns.some(Boolean) ||
    keyHolds.some(holds => holds.size) || buttonHolds.some(holds => holds.size);
  return state === 1;
}
stageBand.addEventListener("click", () => {
  if (!x) return;
  syncStageBand(x, x.emu_ui_section_label_set());
  if (stageBand.disabled) return;
  if (x.emu_conductor_stage_song() !== 1) {
    stageBandResult.textContent = "Band is still settling. Try again when the parts are ready.";
    return;
  }
  stageBand.disabled = true;
  focusStagedBand();
});
function focusStagedBand() {
  syncSongActions(x);
  if (songActions.hidden) return;
  (songAction.disabled ? songBack : songAction).focus({preventScroll: true});
  (phoneLayout.matches ? bigCv : document.getElementById("stage")).scrollIntoView({block: "start"});
}

function syncSongActions(firmware) {
  renderedSongPage = firmware.emu_ui_song_page?.() ?? 0;
  songActions.hidden = !renderedSongPage;
  if (!renderedSongPage) return;
  const adding = !!(renderedSongPage & SONG_ADD);
  const playing = !!(renderedSongPage & SONG_PLAYING);
  const rows = firmware.emu_arr_rows();
  const heading = adding ? "Preview song row" : "Song arrangement";
  const primary = adding ? "Add row" : playing ? "Stop song" : "Play song";
  const back = adding ? "Back to song" : "Back to instrument";
  const preview = adding ? firmware.emu_ui_song_preview?.() ?? 0 : 0;
  const previewStatus = syncSongPreview(firmware, preview);
  const status = adding
    ? rows === 64 ? "Song is full. Go back to make room." : previewStatus || "Check the parts above, then add this row."
    : rows ? rows + (rows === 1 ? " row" : " rows") : "No rows yet. Choose parts to make one.";
  for (const [control, label] of [[songActionHeading, heading], [songAction, primary],
                                   [songBack, back], [songActionStatus, status]]) {
    if (control.textContent !== label) control.textContent = label;
  }
  songAction.disabled = !(renderedSongPage & (SONG_READY | SONG_PLAYING));
  const focusPreview = adding && document.activeElement === songChoose;
  songChoose.hidden = !(renderedSongPage & SONG_CHOOSE);
  if (focusPreview) (songAction.disabled ? songBack : songAction).focus({preventScroll: true});
}
function syncSongPreview(firmware, preview) {
  songPreviewParts.hidden = !preview;
  if (!preview) return "";
  const target = preview >>> 16;
  for (const [lane, row] of songPreviewLanes.entries()) {
    if (lane === target) {
      if (!row.hasAttribute("aria-current")) row.setAttribute("aria-current", "true");
    } else if (row.hasAttribute("aria-current")) row.removeAttribute("aria-current");
    const label = readConductorText(firmware, firmware.emu_ui_song_preview_part(lane));
    const value = row.lastElementChild;
    if (value.textContent !== label) value.textContent = label;
  }
  const steps = preview & 65535;
  const bars = steps / 16;
  const length = steps % 4 ? steps + " steps" : bars + (bars === 1 ? " bar" : " bars");
  return length + " · Editing " + songPreviewLanes[target].firstElementChild.textContent;
}
for (const [control, action] of [[songAction, 0], [songBack, 1], [songChoose, 2]]) {
  control.addEventListener("click", () => {
    if (projectFileBusy || pendingTurns.some(Boolean) || keyHolds.some(holds => holds.size) ||
        buttonHolds.some(holds => holds.size)) return;
    if (!x?.emu_ui_song_press?.(renderedSongPage, action)) return;
    if (action === 0 && !(renderedSongPage & (SONG_ADD | SONG_PLAYING))) void enableSound();
  });
}

redirectForm.addEventListener("change", () => {
  redirectResult.textContent = "";
  syncConductorRedirect(x, x.emu_ui_section_label_set());
});
redirectForm.addEventListener("submit", event => {
  event.preventDefault();
  if (!x) return;
  syncConductorRedirect(x, x.emu_ui_section_label_set());
  if (redirectButton.disabled) return;
  const submit = x.emu_conductor_bank_redirect ?? x.emu_conductor_redirect;
  const result = submit(Number(redirectPlayer.value), Number(redirectSection.value), redirectSet);
  redirectPlayer.value = "";
  redirectSection.value = "";
  redirectResult.textContent = result === 1 ? "" : result === 2
    ? readConductorText(x, x.emu_ui_hint()) || "Redirect refused."
    : "Redirect unavailable on this screen.";
  syncConductorRedirect(x, x.emu_ui_section_label_set());
});

combineSection.addEventListener("change", () => syncConductorCombine(x, x.emu_ui_section_label_set()));
combineAdd.addEventListener("click", () => {
  syncConductorCombine(x, x.emu_ui_section_label_set());
  if (combineAdd.disabled) return;
  const key = combineSection.value;
  const label = combineSection.selectedOptions[0].textContent;
  const item = document.createElement("li");
  const remove = document.createElement("button");
  remove.type = "button";
  remove.textContent = label + " ×";
  remove.setAttribute("aria-label", "Remove " + label);
  remove.addEventListener("click", () => {
    selectedRhythms.delete(key);
    item.remove();
    combineSection.focus();
    combineResult.textContent = "";
    syncConductorCombine(x, x.emu_ui_section_label_set());
  });
  item.append(remove);
  combineMembers.append(item);
  selectedRhythms.add(key);
  combineSection.value = "";
  combineSection.focus();
  combineResult.textContent = "";
  syncConductorCombine(x, x.emu_ui_section_label_set());
});
combinePanel.querySelector("form").addEventListener("submit", event => {
  event.preventDefault();
  if (!x) return;
  syncConductorCombine(x, x.emu_ui_section_label_set());
  if (combineQueue.disabled) return;
  let mask = 0n;
  for (const key of selectedRhythms) mask |= 1n << BigInt(key);
  const result = x.emu_conductor_combine(mask, combineBank);
  if (result === 1 || result === 3) {
    selectedRhythms.clear();
    combineMembers.replaceChildren();
    combineSection.value = "";
  }
  combineResult.textContent = result === 1 ? "" : result === 2 ? "A cue is pending. Wait for it before queuing a mix."
    : result === 3 ? "This mix is already playing."
    : result === 4 ? readConductorText(x, x.emu_ui_hint()) || "This mix was refused."
    : "This mix is unavailable on the current screen.";
  syncConductorCombine(x, x.emu_ui_section_label_set());
});

function syncScopeHint(hint, firmware) {
  let label = "see screen";
  if (firmware.emu_top_mode() === 0 && firmware.emu_nav_landing()) {
    const scope = firmware.emu_conduct_scope();
    label = ["scope: all three", "REC target: Kit A", "REC target: Kit B", "REC target: Dillo"][scope] ?? "scope";
  }
  if (hint.textContent !== label) hint.textContent = label;
}

const conductorText = new TextDecoder("latin1");
const conductorPlayers = ["Kit A", "Kit B", "Dillo"];
function readConductorText(firmware, pointer) {
  if (!pointer) return "";
  const memory = firmware.memory.buffer;
  const bytes = new Uint8Array(memory, pointer, Math.min(256, memory.byteLength - pointer));
  const end = bytes.indexOf(0);
  return end >= 0 ? conductorText.decode(bytes.subarray(0, end)) : "";
}
function syncConductorReadout(firmware, sectionSet) {
  const songRow = firmware.emu_ui_conductor_song_row?.() ?? 0;
  const show = !!(sectionSet || songRow) && !!firmware.emu_ui_conductor_flags;
  if (conductorReadout.hidden === show) conductorReadout.hidden = !show;
  conductorReadout.toggleAttribute("data-song-row", !!songRow && !sectionSet);
  if (!show) { cancelTicket = 0; return; }

  // BB_UI_LN_* from the same frame that supplied the LCD rows.
  const MUTED = 1, NEXT = 2, SOLO = 8, OFF = 16, EDITED = 32;
  const queued = [];
  for (let lane = 0; lane < conductorRows.length; lane++) {
    const flags = firmware.emu_ui_conductor_flags(lane);
    if (flags & NEXT) queued.push(conductorPlayers[lane]);
    const song = readConductorText(firmware, firmware.emu_ui_conductor_song(lane));
    const section = readConductorText(firmware, firmware.emu_ui_conductor_section(lane));
    const state = flags & OFF ? "Off" : flags & MUTED ? "Muted" : flags & SOLO ? "Solo" : "";
    const text = [song, section, flags & EDITED ? songRow ? "Working" : "Edited" : "", state].filter(Boolean).join(" · ") || "No section";
    if (conductorRows[lane].textContent !== text) conductorRows[lane].textContent = text;
  }

  const cue = queued.length ? readConductorText(firmware, firmware.emu_ui_conductor_next()) : "";
  const who = queued.length === 3 ? "All three" : queued.join(" + ");
  const timing = firmware.emu_running() ? "Next at the bar" : "Queued";
  const text = queued.length ? timing + " · " + who + (cue ? " → " + cue : "") :
    songRow ? (firmware.emu_running() ? "Playing song row " : "Song row loaded ") + songRow : "No cue queued";
  if (conductorNext.textContent !== text) conductorNext.textContent = text;
  const canCancel = !!sectionSet && !!firmware.emu_conductor_cancel;
  cancelTicket = canCancel && queued.length && !projectFileBusy && !pendingTurns.some(Boolean)
    ? firmware.emu_ui_conductor_cancel_ticket() : 0;
  conductorCancel.hidden = !canCancel;
  conductorCancel.disabled = !cancelTicket;
}

function conductorBank(sectionSet) {
  return sectionSet ? ((sectionSet - 1) & 0x00ffffff) + 1 : 0;
}

function syncConductorRedirect(firmware, sectionSet) {
  const wholeBank = !!firmware.emu_conductor_bank_redirect;
  const set = wholeBank ? conductorBank(sectionSet) : firmware.emu_conductor_redirect ? sectionSet : 0;
  if (redirectSet !== set) {
    redirectSet = set;
    redirectPlayer.value = "";
    redirectSection.length = 1;
    redirectSection.value = "";
    redirectResult.textContent = "";
    if (set) {
      const offset = wholeBank ? 0 : ((set - 1) >>> 24) * 16;
      const label = wholeBank ? firmware.emu_ui_conductor_bank_section : firmware.emu_ui_section_label;
      for (let index = 0; index < (wholeBank ? 64 : 16); index++) {
        const name = readConductorText(firmware, label(index));
        if (name) redirectSection.add(new Option((offset + index + 1) + " · " + name, String(index)));
        else if (wholeBank) break;
      }
    }
    redirectForm.hidden = !set;
  }
  const disabled = !set || projectFileBusy || pendingTurns.some(Boolean) ||
    !redirectPlayer.value || !redirectSection.value;
  if (redirectButton.disabled !== disabled) redirectButton.disabled = disabled;
}

function syncConductorCombine(firmware, sectionSet) {
  const bank = firmware.emu_conductor_combine ? conductorBank(sectionSet) : 0;
  if (combineBank !== bank) {
    combineBank = bank;
    selectedRhythms.clear();
    combineMembers.replaceChildren();
    combineSection.length = 1;
    combineSection.value = "";
    combineResult.textContent = "";
    if (bank) {
      for (let index = 0; index < 64; index++) {
        const label = readConductorText(firmware, firmware.emu_ui_conductor_bank_section(index));
        if (!label) break;
        combineSection.add(new Option((index + 1) + " · " + label, String(index)));
      }
    }
    combinePanel.hidden = combineSection.length < 3;
  }
  const blocked = !bank || projectFileBusy || pendingTurns.some(Boolean);
  const noAdd = blocked || !combineSection.value || selectedRhythms.has(combineSection.value) || selectedRhythms.size >= 4;
  if (combineAdd.disabled !== noAdd) combineAdd.disabled = noAdd;
  const noQueue = blocked || selectedRhythms.size < 2;
  if (combineQueue.disabled !== noQueue) combineQueue.disabled = noQueue;
}

const drumGroupKeys = [["kick", "kick"], ["sn/cl", "snare and clap"], ["hats", "hi-hats"], ["perc", "percussion"]];
const drumFunctionKeys = [
  ["A/B", "Switch drum deck"], ["Prev section", "Previous section"], ["Next section", "Next section"],
  ["A on/mute", "Enable Drum A or toggle its mute"], ["B on/mute", "Enable Drum B or toggle its mute"], ["Mute Dillo", "Toggle Dillo mute"],
  ["Mute A+B", "Toggle both drum mutes"],
];
const conductorMuteKeys = [
  ["Kit A on/mute", "Enable Kit A or toggle its mute"], ["Kit B on/mute", "Enable Kit B or toggle its mute"],
  ["Mute Dillo", "Toggle Dillo mute"],
];
const conductorSoloKeys = ["Solo Kit A", "Solo Kit B", "Solo Dillo"];
const stepFunctions = ["Voice 1", "Voice 2", "Voice 3", "Voice 4", "Voice 5", "Voice 6", "Voice 7", "Voice 8",
  "Accent", "Prev bank", "Next bank"];
const pitchNames = ["C", "C♯", "D", "D♯", "E", "F", "F♯", "G", "G♯", "A", "A♯", "B"];
function syncFunctionKeys(device, views, drums, conductor, rec, canStageBand = false, stepBank = 0, firmware, drumVoiceKeys = []) {
  const mode = drums ? "drums" : conductor ? "conductor" : "";
  const stage = conductor && !rec && canStageBand;
  const pitch = stepBank >>> 16;
  const stepKeys = stepBank ? stepFunctions.map((name, i) => {
    if (pitch) {
      const note = (firmware.emu_ui_step_pitch?.(16 + i) ?? 0) - 1;
      return note < 0 ? "" : pitchNames[note % 12] + (Math.floor(note / 12) - 1);
    }
    return firmware.emu_led_state(30 + i) ? (i < 8 && drumVoiceKeys[i]?.textContent) || name : "";
  }) : null;
  const legend = stepKeys ? "steps:" + stepKeys.join(",") :
    mode && rec ? mode + "-solo" : stage ? mode + "-stage" : mode;
  if (device.dataset.keyLegend === legend) return;
  device.dataset.keyLegend = legend;
  device.toggleAttribute("data-drum-landing", drums);
  const action = rec ? "Solo " : "Mute ";
  for (let i = 0; i < 11; i++) {
    const group = drums ? drumGroupKeys[i] : null;
    const solo = conductor && rec ? conductorSoloKeys[i] : null;
    const functionKey = drums ? drumFunctionKeys[i - 4] : stage && i === 3 ? ["Stage band", "Stage band for song"] :
      conductor ? conductorMuteKeys[i] : null;
    const [short, full] = stepKeys ? [stepKeys[i], stepKeys[i]] :
      group ? group.map(name => action + name) : solo ? [solo, solo] : functionKey ?? [];
    const number = i + 1;
    const unavailable = stepKeys && !short;
    const label = "Black key " + number + (unavailable ? ": unavailable" : full ? ": " + full : "");
    const [phone, desktop] = views[16 + i];
    phone.firstElementChild.textContent = short || "B" + number;
    phone.setAttribute("aria-label", label);
    desktop.firstElementChild.textContent = label;
    desktop.setAttribute("aria-label", label);
    for (const view of [phone, desktop]) {
      if (unavailable) view.setAttribute("aria-disabled", "true");
      else view.removeAttribute("aria-disabled");
    }
  }
}

/* Controls view: the same seven encoders as rows (Logic-style), sending the same turns as the knobs. */
function makeControls() {
  const host = document.getElementById("ctl-list");
  const phoneSelect = document.getElementById("phone-select");
  const hints = ["instrument / focus", "song / pattern", "kit / sound", "see screen", "see screen", "see screen", "see screen"];
  ENC.forEach((name, e) => {
    const row = document.createElement("div"); row.className = "ctl";
    const nm = document.createElement("div"); nm.className = "name"; nm.innerHTML = name + "<small>" + hints[e] + "</small>";
    const strip = document.createElement("div"); strip.className = "strip"; strip.tabIndex = 0;
    strip.setAttribute("role", "slider"); strip.setAttribute("aria-label", name + " (drag sideways)");
    const mark = document.createElement("i"); strip.append(mark);
    let pos = 50;
    let settle = 0;
    const center = () => { pos = 50; mark.style.setProperty("--p", "50%"); };
    const turn = n => {
      window["turn" + e](n);
      pos = Math.max(4, Math.min(96, pos + n * 4));
      mark.style.setProperty("--p", pos + "%");
      clearTimeout(settle);
      settle = setTimeout(() => { if (!strip.classList.contains("lit")) center(); }, 450);
    };
    bindEncoderDrag(strip, true, 12, turn, center);
    strip.addEventListener("keydown", ev => {
      if (ev.key === "ArrowUp" || ev.key === "ArrowRight") { ev.preventDefault(); ev.stopPropagation(); turn(1); }
      if (ev.key === "ArrowDown" || ev.key === "ArrowLeft") { ev.preventDefault(); ev.stopPropagation(); turn(-1); }
    });
    const steps = document.createElement("div"); steps.className = "steps";
    for (const n of [-5, -1, 1, 5]) {
      const b = document.createElement("button"); b.type = "button"; b.textContent = (n > 0 ? "+" : "−") + Math.abs(n);
      b.setAttribute("aria-label", name + " " + (n > 0 ? "up " : "down ") + Math.abs(n));
      b.addEventListener("click", () => { for (let i = 0; i < Math.abs(n); i++) turn(Math.sign(n)); });
      steps.append(b);
    }
    if (e === 6) nm.querySelector("small").id = "k4-hint";
    row.append(nm, strip, steps); host.append(row);
  });
  const selectRow = host.firstElementChild;
  const placeSelect = () => {
    const target = phoneLayout.matches ? phoneSelect : host;
    if (selectRow.parentElement !== target) target.prepend(selectRow);
  };
  placeSelect();
  phoneLayout.addEventListener("change", placeSelect);
  const kb = document.getElementById("view-knobs"), cb = document.getElementById("view-controls");
  const set = (v) => {
    const ctl = v === "controls";
    document.getElementById("encoders").hidden = ctl; host.hidden = !ctl;
    kb.setAttribute("aria-pressed", String(!ctl)); cb.setAttribute("aria-pressed", String(ctl));
    try { localStorage.setItem("fm1-encoder-view", v); } catch (_) {}
  };
  kb.addEventListener("click", () => set("knobs")); cb.addEventListener("click", () => set("controls"));
  let saved = null; try { saved = localStorage.getItem("fm1-encoder-view"); } catch (_) {}
  set(saved || (phoneLayout.matches ? "controls" : "knobs"));
}

/* ---- the FM-1 panel, drawn as in the player's guide (control boxes measured on the 1750 x 1050 panel photo,
   Felucca tools/gen_panel_diagram.py CTRL), wired to the same firmware inputs as the hidden controls above */
function makePanel() {
  const NS = "http://www.w3.org/2000/svg", svg = document.getElementById("panel");
  const P = {'MASTER':[124,117,219,237],'SELECT':[299,117,394,240],'PRESETS':[114,287,217,410],'ALGORITHM':[286,286,394,413],
             'KNOB 1':[919,113,1019,238],'KNOB 2':[1108,115,1203,238],'KNOB 3':[1294,112,1389,238],'KNOB 4':[1477,113,1577,236]};
  const BTN = {'FX':[962,319,1037,394],'SCL':[1066,318,1141,393],'ENV':[1170,318,1245,393],'LFO':[1274,318,1349,393],'EDIT':[1378,317,1452,392],'GLO':[1482,317,1557,392],
               'HOME':[963,421,1038,497],'SAVE':[1068,420,1143,496],'ARP':[1172,420,1247,496],'SEQ':[1276,420,1351,495],'PLAY':[1380,419,1455,495],'REC':[1483,419,1559,495],
               'OCT-':[154,461,241,509],'OCT+':[284,461,371,508]};
  const KEYS = [91,585,1652,951], SCREEN = [470,70,830,430];
  const el = (n, a, p) => { const e = document.createElementNS(NS, n); for (const k in a) e.setAttribute(k, a[k]); if (p) p.appendChild(e); return e; };
  el('rect', {x:0, y:0, width:1750, height:1020, rx:46, fill:'var(--pbody)'}, svg);
  el('rect', {x:24, y:24, width:1702, height:972, rx:32, fill:'var(--face)'}, svg);
  el('rect', {x:SCREEN[0]-34, y:SCREEN[1]-28, width:SCREEN[2]-SCREEN[0]+68, height:SCREEN[3]-SCREEN[1]+56, rx:26, fill:'#0c0c0d'}, svg);
  el('rect', {x:938, y:296, width:644, height:222, rx:20, fill:'var(--well)'}, svg);
  el('rect', {x:136, y:446, width:252, height:78, rx:16, fill:'var(--well)'}, svg);
  const label = (t, x, y) => { const s = el('text', {x, y, 'text-anchor':'middle', 'font-size':20, fill:'var(--btnink)', 'letter-spacing':2}, svg); s.textContent = t; };
  /* encoders: MASTER is the page volume; the others turn the firmware encoders (same turnN as the Controls view) */
  const encIndex = {'SELECT':0,'ALGORITHM':1,'PRESETS':2,'KNOB 1':3,'KNOB 2':4,'KNOB 3':5,'KNOB 4':6};
  Object.keys(P).forEach(k => {
    const b = P[k], cx = (b[0]+b[2])/2, cy = (b[1]+b[3])/2 + 10, r = 44;
    const g = el('g', {class:'knobg', tabindex:0, role:'slider', 'aria-label':k === 'MASTER' ? 'MASTER (volume)' : k}, svg);
    el('circle', {cx, cy, r:r+8, fill:'var(--well)'}, g);
    el('circle', {class:'cap', cx, cy, r, fill:'var(--knob)'}, g);
    const tick = el('rect', {x:cx-3, y:cy-r+6, width:6, height:22, rx:3, fill:'var(--well)'}, g);
    label(k.replace('KNOB ','K'), cx, b[1]-6);
    let angle = k === 'MASTER' ? (masterLevel * 270 - 135) : 0;
    const show = () => tick.setAttribute('transform', `rotate(${angle} ${cx} ${cy})`);
    if (k === 'MASTER') {
      showMaster = () => {
        angle = masterLevel * 270 - 135;
        g.setAttribute('aria-valuenow', String(Math.round(masterLevel * 100)));
        show();
      };
      g.setAttribute('aria-valuemin', '0');
      g.setAttribute('aria-valuemax', '100');
      showMaster();
    } else show();
    const turn = (n) => {
      if (k === 'MASTER') setMasterLevel(masterLevel + n * 0.04);
      else { window["turn" + encIndex[k]](n); angle += n * 18; show(); }
    };
    g.addEventListener('pointerdown', ev => ev.preventDefault());
    bindEncoderDrag(g, false, 10, turn);
    g.addEventListener('wheel', ev => { ev.preventDefault(); turn(ev.deltaY < 0 ? 1 : -1); }, { passive: false });
    g.addEventListener('keydown', ev => {
      if (ev.key === 'ArrowUp' || ev.key === 'ArrowRight') { ev.preventDefault(); ev.stopPropagation(); turn(1); }
      if (ev.key === 'ArrowDown' || ev.key === 'ArrowLeft') { ev.preventDefault(); ev.stopPropagation(); turn(-1); }
    });
  });
  /* buttons: the same press as the hidden HTML buttons (keeps latch and keyboard shortcuts in one place) */
  Object.keys(BTN).forEach(k => {
    const b = BTN[k], idx = B.indexOf(k);
    const g = el('g', {class:'hit', tabindex:0, role:'button', 'aria-label':k}, svg);
    el('rect', {class:'cap', x:b[0], y:b[1], width:b[2]-b[0], height:b[3]-b[1], rx:14, fill:'var(--pbtn)'}, g);
    const t = el('text', {x:(b[0]+b[2])/2, y:(b[1]+b[3])/2+7, 'text-anchor':'middle', 'font-size':19, fill:'var(--btnink)'}, g); t.textContent = k.replace('-', '−');
    const html = document.getElementById('btn-' + k);
    const fwd = (type, ev) => html.dispatchEvent(new PointerEvent(type, { pointerId: ev.pointerId, shiftKey: ev.shiftKey, bubbles: true }));
    g.addEventListener('pointerdown', ev => { ev.preventDefault(); try { g.setPointerCapture(ev.pointerId); } catch (_) {} fwd('pointerdown', ev); });
    g.addEventListener('pointerup', ev => fwd('pointerup', ev)); g.addEventListener('pointercancel', ev => fwd('pointercancel', ev));
    g.addEventListener('lostpointercapture', ev => fwd('lostpointercapture', ev));
    bindPanelActivation(g, down => holdButton(idx, g, down));
    new MutationObserver(() => { g.classList.toggle('down', html.classList.contains('down') || html.classList.contains('latched')); }).observe(html, { attributes: true, attributeFilter: ['class'] });
  });
  /* keys: 11 black above, 16 white below (logical 0-15 white, 16-26 black, as the firmware numbers them) */
  el('rect', {x:KEYS[0], y:KEYS[1], width:KEYS[2]-KEYS[0], height:KEYS[3]-KEYS[1], rx:30, fill:'var(--well)'}, svg);
  const wx = KEYS[0]+14, ww = (KEYS[2]-KEYS[0]-28)/16;
  for (let i = 0; i < 16; i++) {
    const g = el('g', {class:'hit'}, svg);
    const title = el('title', {}, g);
    el('rect', {class:'cap', x:wx+i*ww+6, y:KEYS[1]+188, width:ww-12, height:150, rx:22, fill:'var(--keyw)'}, g);
    const center = wx+(i+0.5)*ww;
    const name = el('text', {class:'pad-name', x:center, y:KEYS[1]+252, 'text-anchor':'middle', 'aria-hidden':true}, g);
    const top = el('tspan', {x:center}, name);
    const bottom = el('tspan', {x:center, dy:23}, name);
    desktopPadLabels.push({title, top, bottom});
    bindKey(g, i);
  }
  [0.5,1.5,2.5, 4.5,5.5, 7.5,8.5,9.5, 11.5,12.5, 14.5].forEach((p, j) => {
    const k = 16 + j, center = wx + (p + 0.5) * ww;
    const g = el('g', {class:'hit'}, svg);
    el('title', {}, g).textContent = 'Black key ' + (j + 1);
    el('rect', {class:'cap', x:center-ww*0.34, y:KEYS[1]+30, width:ww*0.68, height:132, rx:20, fill:'var(--keyb)'}, g);
    if (k === DRUM_DECK_KEY)
      el('text', {class:'deck-legend', x:center, y:KEYS[1]+125, 'text-anchor':'middle', 'font-size':23, 'aria-hidden':true}, g).textContent = 'A/B';
    bindKey(g, k);
  });
}
let showMaster;
const phoneVolume = document.getElementById('phone-volume');
function setMasterLevel(level) {
  masterLevel = Math.max(0, Math.min(1, level));
  phoneVolume.value = String(Math.round(masterLevel * 100));
  showMaster();
  if (masterGain) masterGain.gain.value = masterLevel;
  if (audio?.state === 'running' && !soundStarting) showSoundStatus();
}
makeEncoders(); makeControls(); makeButtons(); makeKeys(); makePanel();
setMasterLevel(masterLevel);
phoneVolume.addEventListener('input', () => setMasterLevel(Number(phoneVolume.value) / 100));
openDrums.addEventListener("click", () => {
  if (!x?.emu_nav_landing() || pendingTurns[0]) return;
  const mode = x.emu_top_mode();
  if (mode === 1) return;
  revealPhonePads = phoneLayout.matches;
  window.turn0(1 - mode); // Normal SELECT detent from either neighboring instrument.
});

/* The FM-1's own sound library (the file the installer writes), placed where the firmware reads it before start-up.
 * The library URL is reused across builds. Revalidate it before checking the release hash. */
const SOUND_FILES = ["./@LIBRARY_NAME@"];
const SOUND_SHA256 = "@LIBRARY_SHA@";
async function loadSounds(ex) {
  for (const url of SOUND_FILES) {
    try {
      const r = await fetch(url, { cache: "no-cache" });
      if (!r.ok) continue;
      const b = new Uint8Array(await r.arrayBuffer());
      if (b.length !== 245760) continue;
      const h = Array.from(new Uint8Array(await crypto.subtle.digest("SHA-256", b)), v => v.toString(16).padStart(2, "0")).join("");
      if (h !== SOUND_SHA256) continue;
      new Uint8Array(ex.memory.buffer, ex.emu_sound_window(), b.length).set(b);
      return true;
    } catch (_) { /* try the next copy */ }
  }
  return false;
}
loadWasm().then(async ex => {
  const readIdentity = pointer => {
    const bytes = new Uint8Array(ex.memory.buffer); let end = pointer;
    while (end < bytes.length && end - pointer < 80 && bytes[end]) end++;
    if (end >= bytes.length || end - pointer >= 80) throw Error("Invalid firmware identity");
    return new TextDecoder().decode(bytes.subarray(pointer, end));
  };
  if (readIdentity(ex.emu_product_id()) !== @PRODUCT_JSON@ || readIdentity(ex.emu_display_name()) !== @DISPLAY_JSON@) throw Error("Wrong firmware identity");
  if (!await loadSounds(ex)) {
    statusEl.textContent = location.protocol === "file:"
      ? "Open the player through the local server described in START-HERE.md, then reload."
      : "The matching sound library could not load. Restore the original @LIBRARY_NAME@ beside this player, then reload.";
    return;
  }
  if (typeof ex.emu_led_state !== "function") throw Error("Player requires firmware LED-state support");
  ex.emu_init();
  x = ex;
  const kits = x.emu_sound_kits ? x.emu_sound_kits() : 0, note = document.getElementById("kitnote");
  if (note) note.textContent = kits === 7
    ? "The 808, seven sampled kits and BUILD. SLOOP is removed in 2.1. The matching sound library is loaded."
    : "The sampled-library directory could not be read. Reload the player before continuing.";

  for (let i = 0; i < 8; i++) x.emu_frame();
  x.emu_audio_take();
  rememberProject("new");
  draw();
  statusEl.innerHTML = "<span>firmware <b>running</b></span><span>44.1 kHz stereo</span><span>16 ms per main-loop pass</span>";
  document.getElementById("power").disabled = false;
  requestAnimationFrame(loop);
}).catch(error => {
  statusEl.textContent = "The firmware could not start. " + (error.message || String(error));
});
/* Project file adapter. Direct saves are acknowledged only after close. */
