  if (drumRecoveryState & 255) {
    if (x.emu_ui_drum_recover(drumRecoveryState)) syncDrumRecovery(drumPadDeck() >= 0, x.emu_ui_step_bank());
  } else if (masterLevel === 0) {
    setMasterLevel(DRUM_START_LEVEL);
    void enableSound();
  }
});

function drumDeckChangeBlocked() {
