  if (stepPosition.textContent !== position) stepPosition.textContent = position;
  const name = "Drum " + ((stepVoiceContext & 3) === 2 ? "B" : "A") + " voice";
  if (stepVoiceLabel.textContent !== name) stepVoiceLabel.textContent = name;
