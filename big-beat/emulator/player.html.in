let soundStarting = null, soundStartDeadline = 0;
function showSoundStatus() {
  const muted = masterLevel === 0;
  statusEl.textContent = muted
    ? "Sound enabled · volume is at zero · turn up MASTER or Volume"
    : "Firmware running · sound enabled · 44.1 kHz stereo";
  const phoneMessage = muted ? "Volume is at zero. Turn it up to hear BB1." : "Sound enabled";
  if (phoneAudioStatus.textContent !== phoneMessage) phoneAudioStatus.textContent = phoneMessage;
}
function sendButton(button, down) {
  if (!x) return;
  clearPadRepeats();
  if (button === 10 && down) void enableSound();
  x.emu_button(button, down ? 1 : 0);
}
function watchSoundState(context, button) {
  context.addEventListener("statechange", () => {
    if (context !== audio || soundStarting) return;
    const running = context.state === "running";
    button.hidden = running;
    if (running) showSoundStatus();
    else statusEl.textContent = "Sound paused by the browser. Press Enable sound to resume.";
  });
}
function enableSound() {
  if (!x) return Promise.resolve();
  if (soundStarting) return soundStarting;
  const btn = document.getElementById("power");
  const ready = () => {
    btn.hidden = true;
    showSoundStatus();
  };
  if (audio && audio.state === "running") {
    ready();
    return Promise.resolve();
  }
  soundStartDeadline = performance.now() + 250;
  soundStarting = (async () => {
    let resumeTimer;
    try {
      if (!audio || audio.state === "closed") {
        const AC = window.AudioContext || window.webkitAudioContext;
        try { audio = new AC({ sampleRate: 44100 }); } catch (_) { audio = new AC(); }
        watchSoundState(audio, btn);
        masterGain = audio.createGain(); masterGain.gain.value = masterLevel; masterGain.connect(audio.destination);
      }
      await Promise.race([
        audio.resume(),
        new Promise((_, reject) => {
          resumeTimer = setTimeout(() => reject(Error("Sound start timed out")), 2000);
        }),
      ]);
      if (audio.state !== "running") throw Error("Sound is suspended");
      nextT = audio.currentTime + 0.06;
      ready();
    } catch (_) {
      btn.hidden = false;
      statusEl.textContent = "Sound could not start. Press Enable sound to retry; the screen and controls still work.";
    } finally {
      clearTimeout(resumeTimer);
    }
