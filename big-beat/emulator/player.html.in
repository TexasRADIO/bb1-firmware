  const bank = stepBank & 255, length = (stepBank >>> 8) & 255;
  const start = bank * 16 + 1;
  const range = !length || start > length
    ? "No steps on this page"
    : "Steps " + start + "–" + Math.min(length, start + 15) + " of " + length;
