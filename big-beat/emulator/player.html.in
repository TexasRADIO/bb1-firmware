    keyHolds.some(holds => holds.size) || buttonHolds.some(holds => holds.size);
}
function syncDrumDeckButtons(landing) {
  if (drumDecks.hidden === landing) drumDecks.hidden = !landing;
  if (!landing) return;
  const deck = drumPadDeck();
  const blocked = !!drumDeckChangeBlocked();
