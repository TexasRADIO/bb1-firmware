<meta charset="utf-8">
<title>Big Beat Studio BB1 · Browser player</title>
<meta name="robots" content="noindex,nofollow,noarchive,nosnippet">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<style>
/* Layout: one device body, screen and encoders on top, the button bank, then the 27-key keyboard; notes underneath. Single dark look: it is a black instrument. */
:root {
  --room: #121315;         /* page */
  --body: #1d1f22;         /* device shell */
  --body-edge: #2c2f33;
  --cap: #34383d;          /* button caps */
  --cap-down: #ffb547;
  --ink: #e9e6df;          /* printed legends */
  --ink-dim: #8e918f;
  --amber: #ffb547;        /* Big Beat accent (matches the firmware's ember) */
  --white-key: #e8e5dc;
  --black-key: #16171a;
  --display: "Archivo Narrow", "Arial Narrow", system-ui, sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
  color-scheme: dark;
}
html, body { background: var(--room); color: var(--ink); }
body { margin: 0; font-family: var(--display); padding-block: 20px 40px; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
.wrap { max-width: 980px; min-width: 0; margin: 0 auto; display: grid; gap: 18px; }
header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 20px; }
h1 { font-size: 1.6rem; letter-spacing: .02em; margin: 0; font-weight: 700; text-wrap: balance; }
h1 span { color: var(--amber); }
.build { font-family: var(--mono); font-size: .72rem; color: var(--ink-dim); }
.device { background: var(--body); border: 1px solid var(--body-edge); border-radius: 18px; padding: 18px; display: grid; gap: 16px; box-shadow: 0 20px 60px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.04); }
.top { display: grid; grid-template-columns: auto 1fr; gap: 20px; align-items: start; }
.screen-wrap { position: relative; background: #000; border-radius: 6px; padding: 8px; border: 1px solid #000; box-shadow: inset 0 0 0 2px #26292d; }
canvas#screen { display: block; width: 360px; height: 360px; max-width: 100%; image-rendering: auto; }
.power { position: static; min-height: 48px; padding: 12px 18px; display: grid; place-items: center; background: #34383d; border: 0; color: #fff; font: 700 1.05rem var(--display); letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
.power[hidden] { display: none; }
.power small { display: block; font: 400 .72rem var(--mono); letter-spacing: 0; text-transform: none; color: #ddd; margin-top: 6px; }
.power:disabled { opacity: .6; }
.power:focus-visible { outline: 2px solid var(--amber); outline-offset: -4px; }
.controls { display: grid; gap: 16px; min-width: 0; }
.encoders { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px 10px; }
.enc:nth-child(4) { grid-column: 1; }
.enc { display: grid; justify-items: center; gap: 6px; user-select: none; touch-action: none; }
.knob { width: 54px; height: 54px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #4a4f55, #24272b 70%); border: 1px solid #0c0d0e; position: relative; cursor: ns-resize; }
.knob::after { content: ""; position: absolute; left: 50%; top: 5px; width: 3px; height: 14px; margin-left: -1.5px; background: var(--ink); border-radius: 2px; transform-origin: 50% 22px; transform: rotate(var(--a, 0deg)); }
.knob:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }
.enc label { font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-dim); }
.nudge { display: flex; gap: 4px; }
.nudge button { width: 26px; height: 20px; border-radius: 4px; border: 1px solid #0c0d0e; background: var(--cap); color: var(--ink); font: 600 .8rem var(--mono); line-height: 1; cursor: pointer; padding: 0; }
.buttons { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 10px 8px; }
.btn { display: grid; justify-items: center; gap: 5px; }
.btn button { width: 100%; max-width: 64px; height: 30px; border-radius: 6px; border: 1px solid #0c0d0e; background: var(--cap); color: var(--ink); font: 700 .74rem var(--display); letter-spacing: .08em; cursor: pointer; touch-action: none; box-shadow: 0 2px 0 #0c0d0e; }
.btn button.down { background: var(--cap-down); color: #1b1408; transform: translateY(1px); box-shadow: 0 1px 0 #0c0d0e; }
.btn button.latched { outline: 2px dashed var(--amber); outline-offset: 2px; }
.btn button:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }
.btn kbd { font: 400 .62rem var(--mono); color: var(--ink-dim); }
.keyboard { position: relative; height: 150px; touch-action: none; user-select: none; overflow-x: auto; }
.keys { position: relative; height: 100%; min-width: 560px; }
.wk, .bk { position: absolute; top: 0; border: 1px solid #0c0d0e; cursor: pointer; }
.wk { background: var(--white-key); height: 100%; border-radius: 0 0 6px 6px; }
.bk { background: var(--black-key); height: 60%; border-radius: 0 0 4px 4px; z-index: 2; box-shadow: inset 0 -4px 0 #2a2c30; }
.wk.down { background: var(--amber); } .bk.down { background: #a8701f; }
.wk span, .bk span { position: absolute; bottom: 6px; left: 0; right: 0; text-align: center; font: 400 .6rem var(--mono); color: #6c6a64; }
.bk span { color: #7b7e83; }
.notes { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px 28px; font-size: .92rem; line-height: 1.5; color: var(--ink-dim); }
.notes h2 { font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink); margin: 0 0 6px; }
.notes p, .notes ul { margin: 0; max-width: 62ch; }
.notes ul { padding-left: 1.1em; }
.notes code { font-family: var(--mono); font-size: .8rem; color: var(--ink); }
.status { font-family: var(--mono); font-size: .75rem; color: var(--ink-dim); display: flex; gap: 16px; flex-wrap: wrap; }
.status b { color: var(--amber); font-weight: 600; }
.candidate { border: 2px solid #b54137; background: #fff0ed; color: #6d1f18; padding: 10px 14px; font: 700 .78rem/1.4 var(--mono); letter-spacing: .04em; text-transform: uppercase; }
@media (max-width: 760px) {
  .top { grid-template-columns: 1fr; justify-items: center; }
  canvas#screen { width: min(360px, calc(100vw - 80px)); height: auto; aspect-ratio: 1; }
  .controls { width: 100%; }
  .buttons { grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 8px 5px; }
  .btn button { font-size: .6rem; letter-spacing: .02em; height: 34px; }
  .device { padding: 14px; }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
/* Controls view: a Logic-style list editor (one row per encoder) as an alternative to the knobs, for phones */
.view-toggle { display: inline-flex; border: 1px solid #0c0d0e; border-radius: 8px; overflow: hidden; justify-self: start; }
.view-toggle button { font: 700 .72rem var(--display); letter-spacing: .1em; text-transform: uppercase; padding: 8px 14px; min-height: 36px; background: var(--cap); color: var(--ink-dim); border: 0; cursor: pointer; }
.view-toggle button[aria-pressed="true"] { background: var(--amber); color: #1b1408; }
.view-toggle button:focus-visible { outline: 2px solid var(--amber); outline-offset: -2px; }
.ctl-list { display: grid; gap: 8px; }
.ctl-list[hidden], .encoders[hidden] { display: none; }
.ctl { display: grid; grid-template-columns: 88px 1fr auto; align-items: center; gap: 8px; background: #17191c; border: 1px solid #0c0d0e; border-radius: 8px; padding: 6px 8px; }
.ctl .name { font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--ink); }
.ctl .name small { display: block; font: 400 .62rem var(--mono); letter-spacing: 0; text-transform: none; color: var(--ink-dim); }
.ctl .strip { position: relative; height: 40px; border-radius: 6px; background: repeating-linear-gradient(90deg, #26292d 0 1px, #1f2125 1px 14px); border: 1px solid #0c0d0e; touch-action: none; cursor: ew-resize; overflow: hidden; }
.ctl .strip i { position: absolute; top: 4px; bottom: 4px; width: 4px; margin-left: -2px; left: var(--p, 50%); background: var(--amber); border-radius: 2px; transition: left .08s; }
.ctl .strip:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }
.ctl .steps { display: flex; gap: 4px; }
.ctl .steps button { min-width: 40px; height: 40px; border-radius: 6px; border: 1px solid #0c0d0e; background: var(--cap); color: var(--ink); font: 600 .8rem var(--mono); cursor: pointer; padding: 0 4px; }
.ctl .steps button:active { background: var(--cap-down); color: #1b1408; }
@media (max-width: 760px) { .ctl { grid-template-columns: 1fr auto; } .ctl .strip { grid-column: 1 / -1; grid-row: 2; height: 44px; } .ctl .steps button { min-width: 44px; height: 44px; } }

/* ===== Guide look: the player's-guide cover. Light paper, FM-1 wordmark, flat FM-1 panel drawn from
   the guide's measured control boxes (Felucca gen_panel_diagram CTRL), live firmware screen in its window. ===== */
:root {
  --paper:#e9eae8; --sheet:#f6f6f4; --pink:#1b1c1b; --mute:#6b6e69; --line:#c9cbc6;
  --pbody:#45474a; --face:#3a3c3f; --well:#2c2d30; --pbtn:#55585c; --btnink:#c7c9cc; --keyw:#4a4b4f; --keyb:#35363a; --knob:#8d8f92;
  --lit:#ffae41; --litink:#1b1c1b;
  --f-disp:"Archivo","Helvetica Neue",Arial,sans-serif; --f-mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
  color-scheme: light;
  /* the earlier dark tokens, re-pointed at the paper look (the reviewer panel reads these) */
  --room: var(--paper); --ink: #1b1c1b; --ink-dim: #6b6e69; --amber: #ffae41;
  --rv-line-page: #c9cbc6; --rv-card-page: #f6f6f4; --rv-field: #ffffff;
}
html, body { background: var(--paper); color: var(--pink); }
body { font-family: var(--f-disp); }
.wrap { max-width: 1080px; gap: 22px; }
.cover { display: grid; grid-template-columns: 1fr 1fr; gap: 26px 28px; align-items: start; padding: 8px 0 6px; }
.cover .model { font: 400 clamp(64px, 11vw, 112px)/.9 "BB Rodeo", var(--f-disp); letter-spacing: .01em; color: var(--pink); }
.cover .sub { font: 500 clamp(26px, 3.6vw, 40px)/1.15 var(--f-mono); text-transform: lowercase; color: var(--pink); }
.cover .doc { font: 500 clamp(24px, 3.3vw, 38px)/1.3 var(--f-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--pink); }
.cover .ver { font: 500 clamp(24px, 3.3vw, 38px)/1.3 var(--f-mono); color: var(--mute); }
.cover .doc small { display: block; font-size: .42em; letter-spacing: .1em; color: var(--mute); margin-top: 8px; }
section.device { background: transparent; border: 0; box-shadow: none; padding: 0; gap: 14px; }
.stage { position: relative; width: 100%; aspect-ratio: 1750 / 1020; user-select: none; -webkit-user-select: none; touch-action: none; }
.stage svg.panel { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
.stage .screen-wrap { position: absolute; left: 26.857%; top: 6.863%; width: 20.571%; height: 35.294%; padding: 0; border: 0; border-radius: 0; background: #000; box-shadow: none; }
.stage canvas#screen { width: 100%; height: 100%; max-width: none; }
.stage .power { inset: 0; font-size: clamp(.6rem, 1.3vw, 1rem); }
.panel text { font-family: var(--f-mono); text-transform: uppercase; pointer-events: none; }
.panel .hit { cursor: pointer; }
.panel .knobg { cursor: ns-resize; }
.panel .down rect.cap, .panel .down circle.cap, .panel .lit rect.cap { fill: var(--lit); }
.panel .down text, .panel .fw-full text, .panel .lit text { fill: var(--litink); }
.panel .deck-legend { fill: #fff; font-weight: 700; }
.panel .pad-name { fill: #f6f6f4; font-size: 17px; font-weight: 700; }
.panel :is(.down,.fw-full,.fw-mid) .pad-name { fill: var(--litink); }
.panel .fw-breath:not(.down) .pad-name { stroke: var(--litink); stroke-width: 3; paint-order: stroke; }
.device:not([data-drum-landing]) .deck-legend { display:none; }
/* Semantic illumination: CSS contrast is not a physical LED brightness calibration. */
.panel .fw-full rect.cap, .panel .fw-full circle.cap { fill: var(--lit); }
.panel .fw-mid rect.cap { fill: #ad7938; }
.panel .fw-dim rect.cap { fill: #6f573b; }
.panel .fw-breath rect.cap { animation: bb-led-breathe 1.8s ease-in-out infinite alternate; }
@keyframes bb-led-breathe { from { fill: #6f573b; } to { fill: var(--lit); } }
@media (prefers-reduced-motion: reduce) { .panel .fw-breath rect.cap { animation: none; fill: #ad7938; } }
.panel .down rect.cap { fill: var(--lit); }
.panel .knobg:focus-visible circle.cap, .panel .hit:focus-visible rect.cap { stroke: var(--lit); stroke-width: 6; }
.panel g:focus { outline: none; }
.big-screen { display: none; }
.encoders { display: none !important; }
.buttons { display: none !important; }
.keyboard { display: none !important; }
/* Keep focused readout controls rendered across the breakpoint until the
   next frame puts them back beside the desktop panel. */
@media(min-width:761px) {
  .keyboard:has(.conductor-readout), .keys:has(> .conductor-readout) { display:contents !important; }
  .keys:has(> .conductor-readout) > .key-bank { display:none; }
}
.view-toggle { justify-self: center; }
.view-toggle button { background: var(--sheet); color: var(--mute); border: 0; }
.view-toggle { border: 1px solid var(--pink); border-radius: 3px; }
.view-toggle button[aria-pressed="true"] { background: var(--pink); color: var(--paper); }
.ctl { background: var(--sheet); border: 1px solid var(--line); }
.ctl .name { color: var(--pink); } .ctl .name small { color: var(--mute); }
.ctl .strip { background: repeating-linear-gradient(90deg, #d7d9d4 0 1px, #eceeea 1px 14px); border-color: var(--line); }
.ctl .strip i { background: var(--pink); }
.ctl .steps button { background: var(--pbtn); color: #fff; border-color: #2c2d30; }
.status { color: var(--mute); justify-content: center; } .status b { color: #b86a00; }
.notes { color: var(--mute); border-top: 1px solid var(--pink); padding-top: 18px; }
.notes h2 { color: var(--pink); } .notes code { color: var(--pink); }
.controls-row { display: grid; gap: 12px; }
@media (max-width: 760px) {
  .cover { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14px 16px; }
  .cover > * { min-width: 0; overflow-wrap: anywhere; }
  .cover .doc small, .cover .doc small span { overflow-wrap: anywhere; word-break: break-word; }
  .big-screen { display: block; position: relative; box-sizing: border-box; width: min(100%, 360px); aspect-ratio: 1; margin: 0 auto; background: #000; border-radius: 10px; padding: 8px; }
  .big-screen .power { inset: 8px; font-size: 1rem; }
  .cover .model { font-size: 64px; } .cover .sub { font-size: 22px; } .cover .doc, .cover .ver { font-size: 17px; }
  .big-screen canvas { display: block; width: 100%; height: 100%; }
}
</style>
<style id="bb1-20-project-layout">
.project-tools { grid-template-columns:1fr; }
.project-tools button { min-height:44px; padding:8px 14px; margin:4px 4px 4px 0; border:1px solid currentColor; background:transparent; color:inherit; font:inherit; cursor:pointer; }
@media(max-width:760px) { .cover .model { font-size:clamp(40px,12vw,56px); white-space:nowrap; } }

:is(#open-drums,#drum-recover,#drum-audio,#conductor-cancel,#stage-band,#drum-decks button,.song-actions button,.drum-mix button) { min-height:44px; padding:8px 16px; border:1px solid var(--pink); background:var(--sheet); color:var(--pink); font:700 .9rem var(--f-disp); cursor:pointer; }
:is(#open-drums,#drum-recover,#drum-audio,#conductor-cancel,#stage-band,#drum-decks button,.song-actions button,.drum-mix button):disabled { color:var(--mute); border-color:var(--line); cursor:default; }
:is(#open-drums,#drum-recover,#drum-audio,#conductor-cancel,#stage-band,#drum-decks button,.song-actions button,.drum-mix button):focus-visible { outline:2px solid var(--pink); outline-offset:2px; }
#drum-decks:not([hidden]) { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:6px; }
#drum-decks button { padding:6px; }
#drum-decks [aria-pressed="true"] { background:var(--pink); color:var(--sheet); }
#drum-decks #drum-recover[hidden] { display:block; visibility:hidden; }
.conductor-readout { border:1px solid var(--line); padding:10px 12px; color:var(--ink); background:var(--sheet); }
.conductor-readout h2, .conductor-readout p { margin:0; font:700 .85rem/1.4 var(--mono); }
.conductor-readout ul { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:6px 12px; margin:8px 0; padding:0; list-style:none; }
.conductor-readout li { min-width:0; overflow-wrap:anywhere; font:500 .85rem/1.4 var(--mono); }
.conductor-readout strong { color:var(--pink); }
.conductor-readout span { display:block; }
.conductor-readout p { overflow-wrap:anywhere; }
.conductor-cue { display:flex; align-items:center; justify-content:space-between; gap:8px; }
#conductor-cancel { flex:none; }
#stage-band { margin-top:8px; }
.drum-mix { border:1px solid var(--line); padding:10px 12px; background:var(--sheet); }
.drum-mix h2, .drum-mix p { margin:0 0 6px; font:700 .85rem/1.4 var(--mono); }
.drum-mix h2, .drum-mix strong { color:var(--pink); }
.drum-mix > div { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px; }
.drum-mix article { min-width:0; padding:6px; border:1px solid var(--line); font:500 .8rem/1.4 var(--mono); }
.drum-mix article > span { display:block; }
.drum-mix meter { width:100%; height:12px; }
.drum-mix .mix-buttons { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:4px; }
.drum-mix button { padding:4px; }
.drum-mix .mix-mute { grid-column:1 / -1; }
.drum-recovery { border:1px solid var(--line); padding:10px 12px; background:var(--sheet); }
.drum-recovery p { margin:0 0 6px; font:700 .85rem/1.4 var(--mono); }
.step-voice-picker { border:1px solid var(--line); padding:8px 12px; background:var(--sheet); }
.step-position { margin:0 0 8px; color:var(--pink); font:700 .85rem/1.4 var(--mono); }
.step-voice-picker label { display:flex; align-items:center; justify-content:space-between; gap:10px; font:700 .85rem/1.4 var(--mono); }
.step-voice-picker button { width:100%; min-height:44px; margin-top:8px; }
.step-voice-picker select { min-width:0; min-height:44px; padding:4px 8px; font:inherit; color:inherit; background:var(--sheet); border:1px solid var(--line); }
.song-actions { border:1px solid var(--line); padding:10px 12px; background:var(--sheet); }
.song-actions h2, .song-actions p { margin:0 0 6px; font:700 .85rem/1.4 var(--mono); }
.song-actions h2 { color:var(--pink); }
.song-actions div { display:flex; flex-wrap:wrap; gap:8px; }
.song-preview { margin:8px 0; padding:0; list-style:none; font:500 .85rem/1.4 var(--mono); }
.song-preview li { display:grid; grid-template-columns:7ch minmax(0,1fr); gap:8px; padding:4px 6px; overflow-wrap:anywhere; }
.song-preview li[aria-current] { background:var(--bg); box-shadow:inset 2px 0 var(--pink); }
.song-preview strong { color:var(--pink); }
.conductor-redirect:not([hidden]) { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,2fr) auto; align-items:end; gap:8px; margin-top:12px; }
.conductor-redirect label { min-width:0; font:600 .8rem/1.4 var(--mono); }
.conductor-redirect select, .conductor-redirect button { box-sizing:border-box; width:100%; min-height:44px; font:inherit; padding:6px; color:inherit; background:var(--sheet); border:1px solid var(--line); }
.conductor-redirect button { font:700 .85rem var(--mono); }
.conductor-redirect button:disabled { color:var(--mute); }
.conductor-redirect p { grid-column:1/-1; }
.conductor-combine { margin-top:12px; font:600 .85rem/1.4 var(--mono); }
.conductor-combine summary { display:list-item; padding:12px 0; cursor:pointer; }
.conductor-combine form { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:8px; align-items:end; }
.conductor-combine label { min-width:0; }
.conductor-combine form :is(select,button) { box-sizing:border-box; min-height:44px; padding:6px 10px; font:inherit; color:inherit; background:var(--sheet); border:1px solid var(--line); }
.conductor-combine select { width:100%; }
.conductor-combine button:disabled { color:var(--mute); }
.conductor-combine .combine-members, .conductor-combine form p { grid-column:1/-1; }
.conductor-combine .combine-members { display:flex; flex-wrap:wrap; gap:6px; margin:0; }
.conductor-combine .combine-members li { display:block; }
.audio-control { display:contents; }
.phone-master, .phone-select, .phone-audio-status { display:none; }
@media(max-width:760px) {
  .device { display:flex; flex-direction:column; gap:14px; }
  .big-screen, .song-actions, .drum-recovery, .step-voice-picker { order:0; }
  .stage { display:none; }
  #open-drums { order:1; }
  #drum-audio { order:4; scroll-margin-block:12px; }
  #drum-decks, .drum-mix { order:4; }
  .drum-mix > div { grid-template-columns:repeat(2,minmax(0,1fr)); }
  .conductor-readout { order:5; }
  .conductor-readout[data-song-row] { order:0; }
  .keys > .conductor-readout { grid-column:1 / -1; order:0; }
  .conductor-readout ul { grid-template-columns:1fr; }
  .conductor-redirect:not([hidden]) { grid-template-columns:minmax(0,1fr) minmax(0,2fr); }
  .conductor-redirect button { grid-column:1/-1; }
  .conductor-readout li { display:grid; grid-template-columns:7ch minmax(0,1fr); gap:8px; }
  .phone-select { display:block; order:1; }
  .phone-select .ctl { grid-template-columns:auto minmax(0,1fr) auto; }
  .phone-select .strip { grid-column:auto; grid-row:auto; }
  .phone-select .steps button:first-child, .phone-select .steps button:last-child { display:none; }
  .audio-control { display:grid; order:1; }
  .audio-control > * { grid-area:1 / 1; }
  /* Starting audio must not move the pads under a second finger. */
  .power[hidden] { display:grid; visibility:hidden; }
  .power[hidden] + .phone-audio-status { display:grid; place-items:center; }
  .phone-audio-status { padding:12px 18px; border:1px solid var(--line); background:var(--sheet); text-align:center; font:600 .82rem/1.4 var(--mono); }
  .phone-master { display:flex; align-items:center; gap:12px; order:2; color:var(--pink); font:700 .8rem var(--mono); }
  .phone-master input { flex:1; min-width:0; height:44px; }
  .controls-row { display:contents; }
  .buttons { display:grid !important; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px; order:3; }
  .btn button { max-width:none; height:48px; font-size:.78rem; color:#fff; }
  .btn kbd { display:none; }
  .keyboard { display:block !important; height:auto; overflow:visible; order:4; touch-action:auto; user-select:auto; }
  .keys { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:6px; min-width:0; height:auto; }
  .key-bank { display:grid; grid-column:1 / -1; grid-template-columns:repeat(4,minmax(0,1fr)); gap:6px; }
  .key-bank h2 { grid-column:1 / -1; margin:4px 0 2px; font:700 .8rem var(--mono); }
  .key-bank .wk span { padding:0 3px; text-align:center; overflow-wrap:anywhere; }
  [data-drum-landing] .key-bank .wk { scroll-margin-block:12px; }
  [data-drum-landing] .extra-step { display:none; }
  .keys .wk,.keys .bk { position:relative; left:auto !important; width:auto !important; height:48px; border-radius:5px; box-sizing:border-box; touch-action:none; user-select:none; }
  .keys :is(.wk,.bk) > span { position:static; display:grid; place-items:center; height:100%; font:700 .8rem var(--mono); }
  .keys .bk span { color:#fff; padding:0 3px; text-align:center; line-height:1.15; }
  .keys [aria-disabled="true"]:not(.down) { opacity:.45; }
  .btn button.fw-full,.keys .fw-full { background:var(--lit); color:var(--litink); }
  .btn button.fw-mid,.keys .fw-mid { background:#ad7938; }
  .btn button.fw-dim,.keys .fw-dim { background:#6f573b; }
  .btn button.fw-breath,.keys .fw-breath { background:#ad7938; outline:2px solid var(--lit); }
  .keys .fw-full span,.keys .fw-mid span,.keys .fw-dim span { color:#111; }
  .btn button.down,.keys .down { background:var(--lit); color:var(--litink); }
  .keys [role=button]:focus-visible { outline:3px solid #b86a00; outline-offset:2px; }
  .view-toggle { display:none; }
  .ctl-list { display:grid !important; order:5; }
  .status { order:6; }
}
</style>

<div class="wrap">
  <header class="cover">
    <div class="model">FM-1</div>
    <div class="sub">Big Beat<br>Studio BB1</div>
    <div class="doc">browser<br>player<small>the real BB1 firmware, running here <span id="buildstamp">@DISPLAY_HTML@ · @PRODUCT_HTML@ · @WASM_SHORT@</span></small></div>
    <div class="ver">two beats<br>one little box</div>
  </header>
  @CANDIDATE_BANNER@

  <section class="device" aria-label="FM-1 front panel">
    <div class="big-screen"><canvas id="screen-big" width="240" height="240"></canvas></div>
    <button id="open-drums" type="button" disabled>Open drum pads</button>
    <button id="drum-audio" type="button" hidden>Enable pad audio</button>
    <div class="stage" id="stage">
      <svg class="panel" id="panel" viewBox="0 0 1750 1020" role="group" aria-label="FM-1 controls"></svg>
      <div class="screen-wrap">
        <canvas id="screen" width="240" height="240" aria-label="FM-1 display"></canvas>
      </div>
    </div>
    <section class="drum-recovery" id="drum-recovery" aria-label="Drum sound" hidden>
      <p id="drum-recovery-status" role="status"></p>
      <button id="drum-recover" type="button"></button>
    </section>
    <div id="step-voice-picker" class="step-voice-picker" hidden>
      <p id="step-position" class="step-position" role="status"></p>
      <label><span id="step-voice-label">Drum voice</span><select id="step-voice"></select></label>
      <button id="step-voice-audition" type="button" title="Uses the current drum mix">Hear voice</button>
    </div>
    <section class="song-actions" id="song-actions" aria-labelledby="song-action-heading" hidden>
      <h2 id="song-action-heading"></h2>
      <p id="song-action-status" role="status"></p>
      <ul id="song-preview-parts" class="song-preview" aria-label="Parts in this row" hidden>
        <li><strong>Kit A</strong><span></span></li>
        <li><strong>Kit B</strong><span></span></li>
        <li><strong>Dillo</strong><span></span></li>
      </ul>
      <div><button id="song-action" type="button"></button><button id="song-choose" type="button">Choose parts</button><button id="song-back" type="button"></button></div>
    </section>
    <div class="phone-select" id="phone-select"></div>
    <div class="audio-control">
      <button class="power" id="power" type="button" disabled>Enable sound<small>Turn up MASTER or Volume to hear the pads or a song.</small></button>
      <div class="phone-audio-status" id="phone-audio-status" role="status"></div>
    </div>
    <label class="phone-master">VOLUME <input id="phone-volume" type="range" min="0" max="100" value="0" aria-label="Volume"></label>
    <div class="controls-row">
      <div class="view-toggle" role="group" aria-label="Encoder view"><button type="button" id="view-knobs" aria-pressed="true">Knobs</button><button type="button" id="view-controls" aria-pressed="false">Controls</button></div>
      <div class="encoders" id="encoders"></div>
      <div class="ctl-list" id="ctl-list" hidden></div>
      <div class="buttons" id="buttons"></div>
    </div>
    <div id="drum-decks" role="group" aria-label="Drum pad deck" hidden>
      <button type="button" aria-pressed="false" data-deck="0">Drum A</button>
      <button type="button" aria-pressed="false" data-deck="1">Drum B</button>
    </div>
    <div class="keyboard"><div class="keys" id="keys"></div></div>
    <section id="drum-mix" class="drum-mix" aria-labelledby="drum-mix-heading" hidden>
      <h2 id="drum-mix-heading">Drum group mix</h2>
      <p id="drum-mix-help" hidden>Hold REC and press the soloed group's black key to clear solo.</p>
      <div></div>
    </section>
    <section id="conductor-readout" class="conductor-readout" aria-labelledby="conductor-current" hidden>
      <h2 id="conductor-current">Current parts</h2>
      <ul><li><strong>Kit A</strong><span></span></li>
          <li><strong>Kit B</strong><span></span></li>
          <li><strong>Dillo</strong><span></span></li></ul>
      <div class="conductor-cue">
        <p role="status"></p>
        <button id="conductor-cancel" type="button" hidden disabled>Cancel cue</button>
      </div>
      <button id="stage-band" type="button" hidden disabled>Stage band for song</button>
      <p id="stage-band-result" role="status"></p>
      <form id="conductor-redirect" class="conductor-redirect" aria-label="Redirect one player" hidden>
        <label>Player<select id="redirect-player"><option value="">Choose…</option><option value="1">Kit A</option><option value="2">Kit B</option><option value="3">Dillo</option></select></label>
        <label>Section<select id="redirect-section"><option value="">Choose section</option></select></label>
        <button type="submit" disabled>Queue redirect</button>
        <p id="redirect-result" role="status"></p>
      </form>
      <details id="conductor-combine" class="conductor-combine" hidden>
        <summary>Combine rhythms</summary>
        <form aria-label="Build a rhythm mix">
          <p>Choose 2–4 rhythms. Dillo follows the lowest-numbered section.</p>
          <label>Rhythm<select id="combine-section"><option value="">Choose rhythm</option></select></label>
          <button id="combine-add" type="button" disabled>Add</button>
          <ul class="combine-members" aria-label="Rhythms in this mix"></ul>
          <button id="combine-queue" type="submit" disabled>Queue mix</button>
          <p id="combine-result" role="status"></p>
        </form>
      </details>
    </section>
    <div class="status" id="status"><span>loading firmware…</span></div>
  </section>

  <section class="notes project-tools" aria-label="Project files"><div><h2>Project files</h2><p>Save your drum steps, arrangement and sounds as a <b>.bbp2 project</b>. A release-matched player can also verify and open a dependency-bound <b>.bb1bundle</b>.</p><p>Stop playback first. Opening replaces the project in RAM and starts fresh Undo. Saving never changes the project in RAM.</p><button id="project-download" type="button" disabled>Save project (.bbp2)</button> <button id="project-open" type="button" disabled>Open project…</button><input id="project-input" type="file" accept=".bbp2,.bb1bundle,application/octet-stream,application/zip" hidden><p id="project-state" role="status" aria-live="polite">Preparing project files…</p><p id="project-notice" role="status" aria-live="polite">A .bb1bundle opens only when its application, release package, catalogue and sound-library pins match this player exactly.</p><div id="project-recovery" hidden><p>A recovery copy from this tab is available.</p><button id="project-recover" type="button">Recover tab edits</button> <button id="project-recovery-discard" type="button">Discard recovery copy</button></div><p>BB1 can keep a recovery copy for a reload when playback and editing pause. Save a project file to keep your work outside this tab.</p></div></section>
  <section class="notes">
    <div>
      <h2>How to play it</h2>
      <ul>
        <li>Tap a pad or press PLAY to start sound. If the browser needs another gesture, press <b>Enable sound</b>. Turn up <b>MASTER</b> (or <b>Volume</b> on a phone) if the level is at zero.</li>
        <li>Press PLAY on the welcome screen to start the selected song. Turn SELECT on the landing screen to move directly between Rhythm Conductor, Big Beat and Dillo. Hold HOME for help with the current screen.</li>
        <li>From the welcome screen, choose <b>Open drum pads</b> or turn <b>SELECT</b> to Big Beat. When the browser is muted, choose <b>Enable pad audio</b> near the pads to turn on sound at 20% volume. On a phone, the shortcut brings that control or the first pads into view. Tap white keys <b>1–11</b> to play the current kit, whether the song is running or stopped. The browser labels the pads with their current sounds. Switch decks with <b>B5 A/B</b>. If a kit is silent, use the sound notice below the display. Press <b>SEQ</b> (computer key <code>/</code>) to open Steps. Tap a white key to toggle its step, even while stopped. The same sound notice works in Steps. Tap <b>HOME</b> to return to the pads. Use <b>Save project</b> to keep your beat while playback is stopped.</li>
        @STEP_CONDITION_HELP@
        <li>On the Big Beat landing, press black key <b>B5</b> marked <b>A/B</b> (computer key <code>J</code>) to choose which kit you play and edit. If that kit is off, hold <b>REC</b> and press <b>ARP</b> to enable it. In Rhythm Conductor, <b>B2</b> mutes or unmutes Kit B.</li>
        <li>In Rhythm Conductor, the three player rows show each current song and section. The browser also lists the current parts below the panel and names the players and destination of a queued cue. The browser labels the section keys for the current page. On a phone, Current parts and the waiting cue sit just below the Sections bank. Press a lit section key to move the whole band together at the next bar. To cancel a waiting whole-band cue, press its pulsing key again or press the currently playing section key.</li>
        <li>To move just one player, choose Kit A, Kit B or Dillo with <b>K4 SCOPE</b> (computer keys <code>Shift</code> + ←/→), then hold REC and press a section key. In the browser you can also choose a player and any section in the current song or rhythm bank below Current parts, then press <b>Queue redirect</b>. Use <b>Cancel cue</b> while it waits to keep the current parts playing. The next plain section press brings all three back together. Tap HOME to clear the redirect target.</li>
        <li>Open <b>Combine rhythms</b> below Current parts to choose two to four rhythms from the same bank and queue a mix.</li>
        <li>To arrange the current Conductor parts in the browser, stop and choose <b>Stage band for song</b>. Choose <b>Add row</b> under the preview, then <b>Play song</b> when you want to hear the arrangement. On the panel, press <b>B4 BAND</b> on stopped Conductor, then <b>EDIT</b> to add the row. You can also open <b>GLO → white 4 (SONG) → white 1 (ADD)</b> to build a row by hand.</li>
        <li>Knobs: drag up or down on a knob, or scroll over it. MASTER is the volume. On a phone, SELECT is under the screen and the other encoder rows are below the keys. Drag sideways along a strip or tap its − and + buttons.</li>
        <li>Buttons work while held. Shift-click a button to latch it down (for REC + key or HOME-hold), click again to release. On a phone, hold two buttons with two fingers. On iPhone, turn off silent mode to hear it.</li>
        <li>Computer keys: <code>Space</code> PLAY, <code>Enter</code> EDIT, <code>H</code> HOME, <code>R</code> REC, <code>A</code> ARP, <code>/</code> SEQ, <code>[</code> <code>]</code> OCT− / OCT+, arrows turn ALGORITHM (↑↓) and PRESETS (←→). <code>Shift</code> + ↑↓ turns SELECT. <code>Shift</code> + ←→ turns K4 on the Rhythm Conductor landing screen. <code>Esc</code> releases held or latched panel controls.</li>
        <li>Play white keys with <code>Z X C V B N M ,</code> and <code>W E T Y U I O P</code> (<code>Q</code> also plays white 8). Play black keys with <code>S D G F J 2 3 5 6 7 9</code> in panel order.</li>
      </ul>
    </div>
    <div>
      <h2>What this is</h2>
      <p>This is the BB1 firmware itself, running in your browser: the same screen and the same sound engine as on the FM-1. Only the panel around it is drawn for the web.</p>
    </div>
    <div>
      <h2>Good to know</h2>
      <ul>
        <li id="kitnote">Loading the sound library…</li>
        <li>The panel is drawn for the browser. Available controls glow; active controls shine brighter. The browser illustrates the firmware’s light states; it does not calibrate physical LED brightness.</li>
      </ul>
    </div>
  </section>
</div>

<script>
const BUNDLE_PINS = @BUNDLE_PINS_JSON@;
const PROJECT_WIRE_MAX = @PROJECT_WIRE_MAX@;
const WASM_GZ_B64 = "@WASM_GZ_B64@";
const B = ["FX","SCL","ENV","LFO","EDIT","GLO","HOME","SAVE","ARP","SEQ","PLAY","REC","OCT-","OCT+"];
const KEYMAP = {" ":10,"Enter":4,"h":6,"r":11,"a":8,"/":9,"[":12,"]":13};
const ENC = ["SELECT","ALGORITHM","PRESETS","KNOB 1","KNOB 2","KNOB 3","KNOB 4"];
const statusEl = document.getElementById("status");
const phoneAudioStatus = document.getElementById("phone-audio-status");
const openDrums = document.getElementById("open-drums");
const drumAudio = document.getElementById("drum-audio");
const drumDecks = document.getElementById("drum-decks");
const drumDeckButtons = drumDecks.querySelectorAll("[data-deck]");
let requestedDrumDeck = -1;
const drumMix = document.getElementById("drum-mix");
const drumMixHeading = document.getElementById("drum-mix-heading");
const drumMixHelp = document.getElementById("drum-mix-help");
const drumMixStrips = [];
let renderedDrumMixDeck = -1;
const stepVoicePicker = document.getElementById("step-voice-picker");
const stepPosition = document.getElementById("step-position");
const stepVoiceLabel = document.getElementById("step-voice-label");
const stepVoiceSelect = document.getElementById("step-voice");
const stepVoiceAudition = document.getElementById("step-voice-audition");
let stepVoiceContext = 0;
const drumRecovery = document.getElementById("drum-recovery");
const drumRecoveryStatus = document.getElementById("drum-recovery-status");
const drumRecover = document.getElementById("drum-recover");
let drumRecoveryState = 0;
const deviceEl = statusEl.closest(".device");
const conductorReadout = document.getElementById("conductor-readout");
const conductorRows = conductorReadout.querySelectorAll("li span");
const conductorNext = conductorReadout.querySelector('[role="status"]');
const conductorCancel = document.getElementById("conductor-cancel");
const stageBand = document.getElementById("stage-band");
const stageBandResult = document.getElementById("stage-band-result");
const songActions = document.getElementById("song-actions");
const songActionHeading = document.getElementById("song-action-heading");
const songActionStatus = document.getElementById("song-action-status");
const songPreviewParts = document.getElementById("song-preview-parts");
const songPreviewLanes = songPreviewParts.querySelectorAll("li");
const songAction = document.getElementById("song-action");
const songChoose = document.getElementById("song-choose");
const songBack = document.getElementById("song-back");
const SONG_ADD = 2, SONG_READY = 4, SONG_PLAYING = 8, SONG_CHOOSE = 16;
let renderedSongPage = 0;
let cancelTicket = 0, pointerCancelTicket = 0;
const redirectForm = document.getElementById("conductor-redirect");
const redirectPlayer = document.getElementById("redirect-player");
const redirectSection = document.getElementById("redirect-section");
const redirectButton = redirectForm.querySelector("button");
const redirectResult = document.getElementById("redirect-result");
let redirectSet = 0;
const combinePanel = document.getElementById("conductor-combine");
const combineSection = document.getElementById("combine-section");
const combineAdd = document.getElementById("combine-add");
const combineQueue = document.getElementById("combine-queue");
const combineResult = document.getElementById("combine-result");
const combineMembers = combinePanel.querySelector("ul");
const selectedRhythms = new Set();
let combineBank = 0;
const phoneLayout = window.matchMedia("(max-width: 760px)");
let revealPhonePads = false;
const CONDUCTOR_STAGE_KEY = 19; // Logical B4.
let panelStageBandFrame = -1;
const DRUM_DECK_KEY = 20; // Logical B5.
let x = null, audio = null, nextT = 0, lastFrame = 0, frames = 0, masterGain = null, masterLevel = @MASTER@;
const pendingTurns = new Array(7).fill(0);
let livePadBufferUntil = 0;

async function loadWasm() {
  const bin = Uint8Array.from(atob(WASM_GZ_B64), c => c.charCodeAt(0));
  const ds = new Blob([bin]).stream().pipeThrough(new DecompressionStream("gzip"));
  const buf = await new Response(ds).arrayBuffer();
  const { instance } = await WebAssembly.instantiate(buf, { env: { drum909_nparams: () => 0, drum909_param: () => 0 } });
  return instance.exports;
}

/* ---- screen */
const cv = document.getElementById("screen"), cx = cv.getContext("2d"), img = cx.createImageData(240, 240);
const bigCv = document.getElementById("screen-big"), bigCx = bigCv && bigCv.getContext("2d");
function draw() {
  const fb = new Uint16Array(x.memory.buffer, x.emu_fb(), 240 * 240), d = img.data;
  for (let i = 0, j = 0; i < 57600; i++, j += 4) {
    const v = fb[i], r = v >> 11 & 31, g = v >> 5 & 63, b = v & 31;
    d[j] = r << 3 | r >> 2; d[j + 1] = g << 2 | g >> 4; d[j + 2] = b << 3 | b >> 2; d[j + 3] = 255;
  }
  cx.putImageData(img, 0, 0);
  if (bigCx && bigCv.offsetParent) bigCx.drawImage(cv, 0, 0);
}

/* ---- one firmware frame (16 ms), with its audio */
function step() {
  applyDrumDeckRequest();
  replayPadTaps();
  for (let e = 0; e < 7; e++) if (pendingTurns[e]) { const s = Math.sign(pendingTurns[e]); x.emu_turn(e, s); pendingTurns[e] -= s; }
  x.emu_frame(); frames++;
  const n = x.emu_audio_take();
  if (audio && audio.state === "running" && n) {
    const src = new Float32Array(x.memory.buffer, x.emu_audio_ptr(), n * 2);
    const ab = audio.createBuffer(2, n, 44100), L = ab.getChannelData(0), R = ab.getChannelData(1);
    for (let i = 0; i < n; i++) { L[i] = src[2 * i] * 256; R[i] = src[2 * i + 1] * 256; }
    const s = audio.createBufferSource(); s.buffer = ab; s.connect(masterGain || audio.destination);
    // Keep a still-playable queue contiguous when a callback runs late.
    if (nextT < audio.currentTime + 0.008) nextT = audio.currentTime + 0.06;
    s.start(nextT); nextT += ab.duration;
  }
}
function loop(t) {
  if (soundStarting && t < soundStartDeadline) {
    // Leave pressed edges in firmware until the audio clock can play them.
    // A stalled resume must not freeze the panel.
    lastFrame = t;
  } else if (audio && audio.state === "running") {
    // Give live Big Beat pads a shorter queue. A late callback buys a
    // second of extra headroom for the backing pattern before trying again.
    if (nextT < audio.currentTime + 0.03) livePadBufferUntil = t + 1000;
    let guard = 0;
    while (guard++ < 12) {
      let target = 0.12;
      if (x.emu_top_mode() === 1 && x.emu_nav_landing()) {
        if (!x.emu_running()) target = 0.072;
        else if (t >= livePadBufferUntil) target = 0.088;
      }
      if (nextT >= audio.currentTime + target) break;
      step();
    }
  } else {                                     /* no sound yet: the page clock, 16 ms a frame */
    if (!lastFrame) lastFrame = t;
    let guard = 0;
    while (t - lastFrame >= 16 && guard++ < 6) { step(); lastFrame += 16; }
    if (t - lastFrame > 200) lastFrame = t;
  }
  draw();
  drawLights();
  requestAnimationFrame(loop);
}

function drawLights() {
  syncScopeHint(document.getElementById("k4-hint"), x);
  const landing = !!x.emu_nav_landing();
  const drumLanding = x.emu_top_mode() === 1 && landing;
  const drumsShortcutText = drumLanding ? "Big Beat pads open" : "Open drum pads";
  const drumsShortcutDisabled = drumLanding || !landing || !!pendingTurns[0];
  if (openDrums.textContent !== drumsShortcutText) openDrums.textContent = drumsShortcutText;
  if (openDrums.disabled !== drumsShortcutDisabled) openDrums.disabled = drumsShortcutDisabled;
  syncDrumAudio(drumLanding);
  syncDrumDeckButtons(drumLanding);
  syncDrumMix(drumLanding);
  const sectionSet = x.emu_ui_section_label_set?.() ?? 0;
  syncConductorReadout(x, sectionSet);
  const canStageBand = syncStageBand(x, sectionSet);
  syncSongActions(x);
  syncConductorRedirect(x, sectionSet);
  syncConductorCombine(x, sectionSet);
  const stepBank = x.emu_ui_step_bank?.() ?? 0;
  syncDrumRecovery(drumLanding, stepBank);
  const drumVoiceKeys = syncStepVoicePicker(x, stepBank);
  syncFunctionKeys(deviceEl, keyViews, drumLanding, !!sectionSet, !!buttonHolds[11].size, canStageBand, stepBank, x, drumVoiceKeys);
  syncPhoneKeys(drumLanding, sectionSet, stepBank);
  if (panelStageBandFrame >= 0 && frames > panelStageBandFrame && !keyHolds[CONDUCTOR_STAGE_KEY].size) {
    panelStageBandFrame = -1;
    if (x.emu_arr_add_subtitle?.()) focusStagedBand();
  }
  syncPadNames(x, drumLanding, sectionSet, stepBank);
  if (revealPhonePads && !pendingTurns[0]) {
    revealPhonePads = false;
    if (phoneLayout.matches && drumLanding) {
      const firstPad = keyViews[0][0];
      if (drumAudio.disabled) {
        firstPad.focus({preventScroll: true});
        firstPad.scrollIntoView({block: "nearest", inline: "nearest"});
      } else {
        drumAudio.focus({preventScroll: true});
        drumAudio.scrollIntoView({block: "start", inline: "nearest"});
      }
    }
  }
  for (let i = 0; i < 41; i++) {
    const targets = i < 14 ? [document.querySelector('g[aria-label="' + B[i] + '"]'), document.getElementById('btn-' + B[i])] : keyViews[i - 14];
    const state = x.emu_led_state(i);
    const level = state & 1 ? 'full' : state & 4 ? 'mid' : state & 8 ? 'breath' : state & 2 ? 'dim' : 'off';
    for (const el of targets) {
      if (!el || el.dataset.led === level) continue;
      el.dataset.led = level;
      for (const name of ['full','mid','dim','breath']) el.classList.toggle('fw-' + name, name === level);
    }
  }
}

// Tab can move focus before the activation key is released.
function bindPanelActivation(el, press) {
  let held = null;
  const release = () => {
    if (held === null) return;
    held = null;
    press(false);
  };
  el.addEventListener("keydown", ev => {
    if (ev.key !== " " && ev.key !== "Enter") return;
    ev.preventDefault();
    ev.stopPropagation();
    if (ev.repeat || held !== null) return;
    held = ev.key;
    press(true);
  });
  el.addEventListener("keyup", ev => {
    if (held !== ev.key) return;
    ev.preventDefault();
    ev.stopPropagation();
    release();
  });
  el.addEventListener("blur", release);
  el.addEventListener("click", ev => {
    // Pointer and activation-key handlers already sent their press.
    if (ev.detail !== 0 || held !== null) return;
    press(true);
    press(false);
  });
}

/* ---- panel */
const buttonHolds = B.map(() => new Set());
const buttonLatch = Symbol("latched button");
function holdButton(button, source, down) {
  if (!changeHold(buttonHolds[button], source, down)) return;
  sendButton(button, down);
  document.getElementById("btn-" + B[button]).classList.toggle("down", down);
}

function makeButtons() {
